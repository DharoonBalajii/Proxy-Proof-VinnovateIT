{
  "expo": {
    "name": "ProxyProof",
    "slug": "proxyproof",
    "scheme": "proxyproof",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dharoon.proxyproof",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "ProxyProof uses Bluetooth to detect your class's attendance signal and to broadcast it when you run a session.",
        "NSBluetoothPeripheralUsageDescription": "ProxyProof broadcasts a short-lived attendance signal while you run a session.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dharoon.proxyproof",
      "adaptiveIcon": {
        "backgroundColor": "#2A3BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "ProxyProof uses Bluetooth to detect your class's attendance signal and to broadcast it when you run a session."
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": true, "useLegacyPackaging": true } }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
